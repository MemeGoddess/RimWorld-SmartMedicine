<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.7</Version>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    	<GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\DevTools\DevTools\DevTools.csproj" />
      <ProjectReference Include="..\Source\SmartMedicine.csproj" />
    </ItemGroup>

    <!-- Debug Configuration -->
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>..\$(Version)\Assemblies</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>

    <!-- Release Configuration -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>..\$(Version)\Assemblies\</OutputPath>
        <Optimize>true</Optimize>
        <DebugType>embedded</DebugType>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="$(Version).*-*"/>
    </ItemGroup>
</Project>
